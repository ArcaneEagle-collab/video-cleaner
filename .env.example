# Video Cleaner Configuration (Optional Overrides)

# Port for local backend (defaults to dynamic port search starting at 8000)
# VIDEO_CLEANER_PORT=8000

# Custom path for AppData settings and logs
# VIDEO_CLEANER_DATA_DIR=C:\Users\User\AppData\Roaming\Video Cleaner

# Custom path for temporary video frame processing
# VIDEO_CLEANER_TEMP_DIR=C:\Users\User\AppData\Local\Video Cleaner\temp

# Custom default output directory for exported clean videos
# VIDEO_CLEANER_OUTPUTS_DIR=C:\Users\User\Videos\Video Cleaner

# Path to directory containing ffmpeg.exe and ffprobe.exe (defaults to bundled or PATH)
# FFMPEG_DIR=C:\Users\User\ffmpeg\bin
