{
  "name": "video-cleaner",
  "productName": "Video Cleaner",
  "version": "1.1.3",
  "description": "Video Cleaner by Amna - Intelligent editorial image removal and usable footage extractor",
  "main": "desktop/main.js",
  "author": {
    "name": "Amna"
  },
  "scripts": {
    "bundle:ffmpeg": "py -3.11 scripts/bundle_ffmpeg.py",
    "build:backend": "py -3.11 scripts/build_backend.py",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run bundle:ffmpeg && npm run build:backend && npm run build:frontend",
    "desktop:start": "electron .",
    "dist": "electron-builder --config electron-builder.json",
    "checksum": "py -3.11 scripts/generate_checksums.py"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
